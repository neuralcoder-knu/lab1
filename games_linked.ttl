@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gm: <https://example.org/games/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gm:Country a rdfs:Class ;
    rdfs:label "Country"@en ;
    rdfs:subClassOf schema:Country .

gm:Game a rdfs:Class ;
    rdfs:label "Game"@en ;
    rdfs:subClassOf schema:VideoGame .

gm:Genre a rdfs:Class ;
    rdfs:label "Genre"@en ;
    rdfs:subClassOf schema:Thing .

gm:Person a rdfs:Class ;
    rdfs:label "Person"@en ;
    rdfs:subClassOf schema:Person .

gm:Platform a rdfs:Class ;
    rdfs:label "Platform"@en ;
    rdfs:subClassOf schema:Thing .

gm:Publisher a rdfs:Class ;
    rdfs:label "Publisher"@en ;
    rdfs:subClassOf schema:Organization .

gm:Studio a rdfs:Class ;
    rdfs:label "Studio"@en ;
    rdfs:subClassOf schema:Organization .

gm:basedIn a rdf:Property ;
    rdfs:domain gm:Studio ;
    rdfs:range gm:Country .

gm:developedBy a rdf:Property ;
    rdfs:domain gm:Game ;
    rdfs:range gm:Studio .

gm:foundedBy a rdf:Property ;
    rdfs:domain gm:Studio ;
    rdfs:range gm:Person .

gm:foundingYear a rdf:Property ;
    rdfs:domain gm:Studio ;
    rdfs:range xsd:integer .

